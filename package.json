{
  "name": "bluenote-blog",
  "version": "2.0.0",
  "private": true,
  "description": "Blue Note — Markdown-first Hexo blog published with GitHub Pages",
  "scripts": {
    "clean": "cross-env TZ=America/New_York hexo clean",
    "build": "cross-env TZ=America/New_York hexo clean && cross-env TZ=America/New_York hexo generate",
    "check": "npm run build && node tooling/validate-site.mjs && node tooling/validate-private-vault.mjs",
    "server": "cross-env TZ=America/New_York hexo server",
    "new": "cross-env TZ=America/New_York hexo new post",
    "gallery:prepare": "node tooling/prepare-gallery-images.mjs",
    "private:hide": "node tooling/private-posts.mjs hide",
    "private:publish": "node tooling/private-posts.mjs publish",
    "private:sync": "node tooling/private-posts.mjs sync",
    "private:restore": "node tooling/private-posts.mjs restore",
    "private:list": "node tooling/private-posts.mjs list"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "cross-env": "10.1.0",
    "hexo": "8.1.2",
    "hexo-front-matter": "4.2.1",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-search": "2.4.3",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-fluid": "1.9.9",
    "marked": "15.0.12"
  }
}
